{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "システム構成図のノード",
    "description": "d3.deployment に渡すノード。children に子のノードを入れ子で持つ。id は子のノードも含めて一意にする。link を付けると、ノードの左下にリンクを出す。",
    "type": "array",
    "items": { "$ref": "#/$defs/node" },
    "$defs": {
        "node": {
            "type": "object",
            "properties": {
                "id":   { "type": "integer" },
                "type": { "enum": ["NODE", "COMPONENT"] },
                "label": {
                    "type": "object",
                    "properties": {
                        "text":     { "type": "string" },
                        "position": { "$ref": "#/$defs/point" },
                        "font":     { "$ref": "#/$defs/font" }
                    },
                    "required": ["text"],
                    "additionalProperties": false
                },
                "size":     { "$ref": "#/$defs/size" },
                "position": { "$ref": "#/$defs/point" },
                "link":     { "$ref": "#/$defs/link" },
                "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
            },
            "required": ["id", "type", "label", "size", "position", "children"],
            "additionalProperties": false
        },
        "link": {
            "description": "ノードの左下に出すリンク。押すと url を新しいタブで開く。",
            "type": "object",
            "properties": {
                "url": { "type": "string" }
            },
            "required": ["url"],
            "additionalProperties": false
        },
        "point": {
            "type": "object",
            "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
            },
            "required": ["x", "y"],
            "additionalProperties": false
        },
        "size": {
            "type": "object",
            "properties": {
                "w": { "type": "number" },
                "h": { "type": "number" }
            },
            "required": ["w", "h"],
            "additionalProperties": false
        },
        "font": {
            "type": "object",
            "properties": {
                "size":   { "type": "number" },
                "color":  { "type": "string" },
                "weight": { "type": ["string", "number"] }
            },
            "additionalProperties": false
        }
    }
}
