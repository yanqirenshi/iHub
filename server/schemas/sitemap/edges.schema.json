{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "画面遷移図の遷移",
    "description": "画面のノードの間の遷移。from.id/to.id はノードの id を指す。position はポートを取り付ける角度。",
    "x-id-start": 2000001,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id":   { "type": "integer" },
            "from": { "$ref": "#/$defs/end" },
            "to":   { "$ref": "#/$defs/end" },
            "stroke": {
                "type": "object",
                "properties": {
                    "color": { "type": "string" },
                    "width": { "type": "number" },
                    "type":  { "type": "string" }
                },
                "additionalProperties": false
            }
        },
        "required": ["id", "from", "to"],
        "additionalProperties": false
    },
    "$defs": {
        "end": {
            "type": "object",
            "properties": {
                "id":       { "type": "integer" },
                "position": { "type": "number" }
            },
            "required": ["id"],
            "additionalProperties": false
        }
    }
}
