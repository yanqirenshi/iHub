{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TM のエンティティ",
    "description": "TM (T字形ER) のエンティティ。type は 10 種の種別 (これ以外は d3.ter が描画時に例外にする)。識別子・属性はマスタの id を参照するインスタンスとして持ち、インスタンスの id は全エンティティを通して一意 (関係の details がこれを指す)。name は文字列か論理名・物理名の組。position はドラッグで書き換わる。size の w / h が 0 のときは内容に合わせる。",
    "x-id-start": 30000,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": [
                    "integer",
                    "string"
                ]
            },
            "type": {
                "enum": [
                    "RESOURCE",
                    "RESOURCE-SUBSET",
                    "EVENT",
                    "EVENT-SUBSET",
                    "COMPARATIVE",
                    "CORRESPONDENCE",
                    "RECURSION",
                    "MANY-VALUED-OR",
                    "MANY-VALUED-AND",
                    "CLASS"
                ]
            },
            "name": {
                "description": "文字列、または論理名と物理名の組",
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "logical": {
                                "type": "string"
                            },
                            "physical": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "position": {
                "type": "object",
                "properties": {
                    "x": {
                        "type": "number"
                    },
                    "y": {
                        "type": "number"
                    },
                    "z": {
                        "type": "number"
                    }
                },
                "required": [
                    "x",
                    "y"
                ],
                "additionalProperties": false
            },
            "size": {
                "type": "object",
                "properties": {
                    "w": {
                        "type": "number",
                        "minimum": 0
                    },
                    "h": {
                        "type": "number",
                        "minimum": 0
                    }
                },
                "required": [
                    "w",
                    "h"
                ],
                "additionalProperties": false
            },
            "identifiers": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        },
                        "identifier": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        },
                        "name": {
                            "description": "文字列、または論理名と物理名の組",
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "logical": {
                                            "type": "string"
                                        },
                                        "physical": {
                                            "type": "string"
                                        },
                                        "description": {
                                            "type": "string"
                                        }
                                    },
                                    "additionalProperties": true
                                }
                            ]
                        },
                        "description": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "identifier"
                    ],
                    "additionalProperties": true
                }
            },
            "attributes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        },
                        "attribute": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        },
                        "name": {
                            "description": "文字列、または論理名と物理名の組",
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "logical": {
                                            "type": "string"
                                        },
                                        "physical": {
                                            "type": "string"
                                        },
                                        "description": {
                                            "type": "string"
                                        }
                                    },
                                    "additionalProperties": true
                                }
                            ]
                        },
                        "description": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "attribute"
                    ],
                    "additionalProperties": true
                }
            }
        },
        "required": [
            "id",
            "type",
            "name"
        ],
        "additionalProperties": true
    }
}
