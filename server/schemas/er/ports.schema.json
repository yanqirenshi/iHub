{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ER 図のポート",
    "description": "リレーションシップの線の端点。",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "_id":         { "type": "integer" },
            "_class":      { "enum": ["PORT-ER-OUT", "PORT-ER-IN"] },
            "degree":      { "type": "number", "description": "取り付ける角度" },
            "cardinality": { "enum": [1, 3], "description": "1 か 多 (3)。省略すると 1" },
            "optionality": { "enum": [0, 1], "description": "0 は任意、1 は必須。省略すると 1" }
        },
        "required": ["_id", "_class", "degree"],
        "additionalProperties": false
    }
}
