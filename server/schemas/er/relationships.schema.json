{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ER 図の関係",
    "description": "エンティティどうしの関係 (FK など)。from / to はエンティティの id と、その端の見た目 (カーディナリティ・オプショナリティ・接続位置の角度) を持つ。details は線を取り付けるインスタンスの id (省略すると各エンティティの先頭の識別子)。",
    "x-id-start": 10000000,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": [
                    "integer",
                    "string"
                ]
            },
            "type": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "from": {
                "$ref": "#/$defs/end"
            },
            "to": {
                "$ref": "#/$defs/end"
            },
            "details": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "from": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": [
                                        "integer",
                                        "string"
                                    ]
                                }
                            },
                            "required": [
                                "id"
                            ]
                        },
                        "to": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": [
                                        "integer",
                                        "string"
                                    ]
                                }
                            },
                            "required": [
                                "id"
                            ]
                        }
                    },
                    "required": [
                        "from",
                        "to"
                    ]
                }
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "hide": {
                "type": "boolean"
            }
        },
        "required": [
            "id",
            "from",
            "to"
        ],
        "additionalProperties": true
    },
    "$defs": {
        "end": {
            "type": "object",
            "properties": {
                "entity": {
                    "type": [
                        "integer",
                        "string"
                    ]
                },
                "cardinality": {
                    "enum": [
                        1,
                        3
                    ]
                },
                "optionality": {
                    "enum": [
                        0,
                        1
                    ]
                },
                "position": {
                    "type": "number",
                    "description": "接続位置の角度。0=真下・時計回り (90=左 / 180=真上 / 270=右)"
                }
            },
            "required": [
                "entity"
            ],
            "additionalProperties": true
        }
    }
}
