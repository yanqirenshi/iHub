{
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@yanqirenshi/ihub.core": "^0.2.0",
    "@yanqirenshi/ihub.srv": "^0.2.0",
    "@yanqirenshi/manipulater": "^0.1.0",
    "@yanqirenshi/markdown.sitter": "^0.1.5",
    "concurrently": "^10.0.6",
    "http-proxy-middleware": "^2.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^6.0.0"
  },
  "scripts": {
    "start": "concurrently -k -n web,api -c cyan,green \"npm:start:web\" \"npm:start:api\"",
    "start:web": "react-scripts start",
    "start:api": "ihub-srv --data data",
    "build": "react-scripts build",
    "serve": "ihub-srv --data data --static build",
    "test:data": "ihub-srv check data"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
