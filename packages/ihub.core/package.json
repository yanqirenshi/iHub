{
  "name": "@yanqirenshi/ihub.core",
  "version": "0.1.1",
  "description": "iHub のコア (画面の部品)。設計データを、図や表で見て、編集する。",
  "keywords": [
    "ihub",
    "react",
    "wbs",
    "er",
    "diagram",
    "design-document"
  ],
  "homepage": "https://github.com/yanqirenshi/iHub/tree/main/packages/ihub.core#readme",
  "bugs": {
    "url": "https://github.com/yanqirenshi/iHub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanqirenshi/iHub.git",
    "directory": "packages/ihub.core"
  },
  "license": "MIT",
  "author": "yanqirenshi@gmail.com",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./index.css": "./dist/index.css",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --delete-dir-on-start && node scripts/copy-assets.mjs",
    "build:watch": "node scripts/copy-assets.mjs && babel src --out-dir dist --watch",
    "prepublishOnly": "npm run build"
  },
