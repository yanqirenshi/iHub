{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ER 図の属性",
    "description": "属性 (カラム) のマスタ。entities[].attributes[].attribute から id で参照される。",
    "x-id-start": 20000,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": [
                    "integer",
                    "string"
                ]
            },
            "name": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "logical": {
                                "type": "string"
                            },
                            "physical": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "data_type": {
                "type": [
                    "string",
                    "null"
                ]
            }
        },
        "required": [
            "id"
        ],
        "additionalProperties": true
    }
}
