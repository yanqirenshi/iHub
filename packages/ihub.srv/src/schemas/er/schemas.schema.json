{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ER 図のスキーマ",
    "description": "テーブルの名前空間。entities[].schema から id で参照される。描画には使わない。",
    "x-id-start": 1,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": [
                    "integer",
                    "string"
                ]
            },
            "name": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "logical": {
                                "type": "string"
                            },
                            "physical": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "data_type": {
                "description": "データ型。オブジェクト { type, length, scale, description }、または 0.2.1 までの文字列(型の名前。{ type } と同じ意味)",
                "anyOf": [
                    {
                        "description": "データ型。type は自由な文字列、length は 1 以上の整数、scale は 0 以上の整数、description は 1 要素 = 1 行",
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "type": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "length": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 1
                            },
                            "scale": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "description": {
                                "type": [
                                    "array",
                                    "null"
                                ],
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "additionalProperties": true
                    },
                    {
                        "type": "string"
                    }
                ]
            }
        },
        "required": [
            "id"
        ],
        "additionalProperties": true
    }
}
