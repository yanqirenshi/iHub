{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ER 図のエンティティ",
    "description": "テーブル。識別子・属性は、マスタの id を参照するインスタンス (identifiers / attributes) として持つ。インスタンスの id は全エンティティを通して一意 (関係の details がこれを指す)。position はドラッグで動かすと書き換わる。size の w / h が 0 のときは内容に合わせる。",
    "x-id-start": 30000,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": [
                    "integer",
                    "string"
                ]
            },
            "name": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "logical": {
                                "type": "string"
                            },
                            "physical": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            },
            "code": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "schema": {
                "type": [
                    "integer",
                    "string",
                    "null"
                ]
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "position": {
                "type": "object",
                "properties": {
                    "x": {
                        "type": "number"
                    },
                    "y": {
                        "type": "number"
                    },
                    "z": {
                        "type": "number"
                    }
                },
                "required": [
                    "x",
                    "y"
                ],
                "additionalProperties": false
            },
            "size": {
                "type": "object",
                "properties": {
                    "w": {
                        "type": "number",
                        "minimum": 0
                    },
                    "h": {
                        "type": "number",
                        "minimum": 0
                    }
                },
                "required": [
                    "w",
                    "h"
                ],
                "additionalProperties": false
            },
            "color": {
                "type": "object",
                "description": "テーブルの色 (任意。#159)。CSS の色の文字列。書いていない色は既定 (ENTITY_DEFAULTS.color) で描く。",
                "properties": {
                    "base": {
                        "type": "string",
                        "description": "テーブルの外枠の背景色"
                    },
                    "inner": {
                        "type": "string",
                        "description": "テーブル名とカラムの欄の背景色"
                    }
                },
                "additionalProperties": false
            },
            "identifiers": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        },
                        "identifier": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "identifier"
                    ],
                    "additionalProperties": true
                }
            },
            "attributes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        },
                        "attribute": {
                            "type": [
                                "integer",
                                "string"
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "attribute"
                    ],
                    "additionalProperties": true
                }
            }
        },
        "required": [
            "id"
        ],
        "additionalProperties": true
    }
}
