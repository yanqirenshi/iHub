{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "システム構成図のノード",
    "description": "d3.deployment に渡すノード。children に子のノードを入れ子で持つ。id は子のノードも含めて一意にする。position は親の中での位置で、ドラッグで動かすと書き換わる。link を付けると、ノードの左下にリンクを出す。見た目の項目 (label・padding・border・background・description) は d3.deployment の入力の形のまま書ける。",
    "x-id-start": 1,
    "type": "array",
    "items": {
        "$ref": "#/$defs/node"
    },
    "$defs": {
        "node": {
            "type": "object",
            "properties": {
                "id": {
                    "type": [
                        "integer",
                        "string"
                    ]
                },
                "type": {
                    "enum": [
                        "NODE",
                        "COMPONENT"
                    ]
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "text": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "size": {
                    "type": "object",
                    "properties": {
                        "w": {
                            "type": "number",
                            "minimum": 0
                        },
                        "h": {
                            "type": "number",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "w",
                        "h"
                    ]
                },
                "position": {
                    "type": "object",
                    "properties": {
                        "x": {
                            "type": "number"
                        },
                        "y": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "x",
                        "y"
                    ]
                },
                "link": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "properties": {
                        "url": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/node"
                    }
                }
            },
            "required": [
                "id"
            ],
            "additionalProperties": true
        }
    }
}
