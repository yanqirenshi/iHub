{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "WBS のワークパッケージ",
    "description": "WBS の下のワークパッケージ。parent は WBS の id。id は projects・wbs とまたいで一意にする。_class は読み込み時に付けるので、データには書かない。plan (予定の期間) は任意で、書くと、艦橋の Schedule タブに矢羽根で出る。",
    "x-id-start": 1000000,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id":          { "type": "integer" },
            "parent":      { "type": "integer" },
            "name":        { "type": "string" },
            "description": { "$ref": "#/$defs/description" },
            "type":        { "type": ["string", "null"], "description": "ページのファイルを置くフォルダ (src/wbs/{type}/P{id}.js)" },
            "plan":        { "$ref": "#/$defs/plan" }
        },
        "required": ["id", "parent", "name"],
        "additionalProperties": false
    },
    "$defs": {
        "date": {
            "description": "日付。'YYYY-MM-DD' の形の文字列 (例: '2026-11-30')",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "plan": {
            "description": "予定の期間。from と to は、どちらも書く。to は、from と同じ日か、あと。(日付として正しいことと、to が from より前でないことは、スキーマではなく、ルールで検査する)",
            "type": "object",
            "properties": {
                "from": { "$ref": "#/$defs/date", "description": "始まりの日" },
                "to":   { "$ref": "#/$defs/date", "description": "終わりの日" }
            },
            "required": ["from", "to"],
            "additionalProperties": false
        },
        "description": {
            "description": "文字列、または段落ごとの文字列の配列",
            "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
            ]
        }
    }
}
