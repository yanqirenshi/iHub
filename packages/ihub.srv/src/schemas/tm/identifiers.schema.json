{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TM の識別子のマスタ",
    "description": "識別子 (個体指定子) のマスタ。entities[].identifiers[].identifier から id で参照される。",
    "x-id-start": 10000,
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": [
                    "integer",
                    "string"
                ]
            },
            "name": {
                "description": "文字列、または論理名と物理名の組",
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "logical": {
                                "type": "string"
                            },
                            "physical": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "data_type": {
                "description": "データ型。type は自由な文字列、length は 1 以上の整数、scale は 0 以上の整数、description は 1 要素 = 1 行",
                "type": [
                    "object",
                    "null"
                ],
                "properties": {
                    "type": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "length": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1
                    },
                    "scale": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "description": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "additionalProperties": true
            }
        },
        "required": [
            "id",
            "name"
        ],
        "additionalProperties": true
    }
}
