# GitHub の個人用アクセストークン (GitHub と連携するとき)
REACT_APP_GITHU_PARSONAL_TOKEN=

# GitHub の OAuth App (OAuth で認証するときだけ要る。API サーバーが読む。画面には入らない)
# Authorization callback URL: http://localhost:3000/api/github/oauth/callback
# (開発サーバーのポートを変えているときは、そのポートにする)
# 詳しくは、iHub のマニュアルの「GitHub との連携」を見る。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
