{
  "name": "ihub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@yanqirenshi/d3.gantt": "^0.1.11",
    "@yanqirenshi/d3.network": "^0.9.0",
    "@yanqirenshi/ihub.core": "^0.1.0",
    "@yanqirenshi/ihub.srv": "^0.1.0",
    "@yanqirenshi/manipulater": "^0.0.20",
    "@yanqirenshi/markdown.sitter": "^0.1.5",
    "concurrently": "^10.0.6",
    "http-proxy-middleware": "^2.0.10",
    "react": "^18.3.1",
    "react-bpmn": "^0.2.0",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^6.0.0",
    "winbox": "^0.2.82",
    "workbox-background-sync": "^7.4.1",
    "workbox-broadcast-update": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-google-analytics": "^7.4.1",
    "workbox-navigation-preload": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-streams": "^7.4.1"
  },
  "scripts": {
    "start": "concurrently -k -n web,api,core -c cyan,green,yellow \"npm:start:web\" \"npm:start:api\" \"npm:build:core:watch\"",
    "prestart": "npm run build -w @yanqirenshi/ihub.core",
    "start:web": "react-scripts start",
    "start:api": "node --watch-path=packages/ihub.srv/src packages/ihub.srv/bin/ihub-srv.mjs --data data",
    "build:core:watch": "npm run build:watch -w @yanqirenshi/ihub.core",
    "serve": "ihub-srv --data data --static build",
    "prebuild": "npm run build -w @yanqirenshi/ihub.core",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:data": "npm run build -w @yanqirenshi/ihub.core && ihub-srv check data packages/ihub.core/examples/data && npm test -w @yanqirenshi/ihub.srv",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
